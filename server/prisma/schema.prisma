// Skema database MITA (tahap 5). Isi chat sengaja TIDAK disimpan (docs/RANCANGAN.md bagian 4).
// Ubah skema lalu buat migrasi: npx prisma migrate dev --name <nama>  (butuh DATABASE_URL).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  mahasiswa
  dosen
}

/// menunggu -> disetujui / ditolak oleh admin di /panel; disetujui -> nonaktif bila diblokir.
enum AccountStatus {
  menunggu
  disetujui
  ditolak
  nonaktif
}

model Account {
  /// Id internal: nama bisa kembar, NIM/NIP bisa salah ketik, jadi relasi memakai id ini.
  id                 String        @id @default(uuid()) @db.Uuid
  role               Role
  /// NIM (mahasiswa) atau NIP (dosen), hanya angka.
  loginId            String        @unique @map("login_id")
  fullName           String        @map("full_name")
  passwordHash       String        @map("password_hash")
  /// Diset saat admin me-reset kata sandi: pengguna wajib menggantinya setelah masuk.
  mustChangePassword Boolean       @default(false) @map("must_change_password")
  status             AccountStatus @default(menunggu)
  /// Label dari admin, tampil di name tag sebagai "[tag] Nama" (mis. "Asdos", "Ketua").
  tag                String?
  /// Pilihan avatar (CharacterChoice); null = belum membuat avatar.
  character          Json?
  createdAt          DateTime      @default(now()) @map("created_at")
  reviewedAt         DateTime?     @map("reviewed_at")
  lastLoginAt        DateTime?     @map("last_login_at")
  sessions           Session[]

  @@map("accounts")
}

model Session {
  /// SHA-256 dari token; token asli hanya dipegang browser.
  tokenHash String   @id @map("token_hash")
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([accountId])
  @@map("sessions")
}
