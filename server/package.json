{
  "name": "@mita/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --external:@fastify/static --external:@colyseus/* --external:@prisma/* --external:pg --external:mysql2 --external:yaml --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/ws-transport": "^0.18.4",
    "@fastify/static": "^10.1.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.7",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@mita/shared": "*",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
