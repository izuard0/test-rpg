{
  "name": "@mita/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --external:fastify --external:@fastify/static --external:@colyseus/* --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.36",
    "@colyseus/ws-transport": "^0.18.4",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@mita/shared": "*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
