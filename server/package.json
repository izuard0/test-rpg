{
  "name": "@mita/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@mita/shared": "*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
