{
  "name": "mita",
  "private": true,
  "description": "MITA · Virtual Class Prodi Informatika (game RPG 2D pixel di browser)",
  "type": "module",
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "sql.js": "^1.15.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
